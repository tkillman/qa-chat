# QA Chat 환경 변수 템플릿
# .env 파일로 복사하여 실제 값을 입력하세요
# cp .env.example .env

# ============================================
# 관리자 인증
# ============================================
ADMIN_PASSWORD=1234

# ============================================
# 검색 설정
# ============================================
# 유사도 임계값 (0.0 ~ 1.0)
# 0.7: 엄격한 필터링, 0.6: 더 많은 결과
SIMILARITY_THRESHOLD=0.7

# 사용자 질문 최대 길이
MAX_USER_QUESTION_LENGTH=1024

# 관리자 질문 최대 길이
MAX_ADMIN_QUESTION_LENGTH=500

# 관리자 답변 최대 길이
MAX_ADMIN_ANSWER_LENGTH=2000

# ============================================
# 데이터 저장소
# ============================================
# 데이터 디렉토리
DATA_DIR=./data

# Q&A 초기 데이터 파일 경로
INIT_FILE_PATH=./data/init.txt

# ChromaDB 저장소 경로
CHROMA_PERSIST_DIR=./.chroma

# ChromaDB 초기화 여부 (배포 시 기존 데이터 제거)
# HF Spaces 배포 후 이전 데이터로 오염된 경우 true로 설정
# 일회성이므로 배포 후 다시 false로 변경하세요
RESET_CHROMA_ON_STARTUP=false

# ============================================
# Langfuse (관찰성) - 선택사항
# ============================================
# Langfuse 없이 실행할 수 있습니다.
# 계정이 있으면 아래 값들을 설정하세요.

# 주의: 아직 구성되지 않음 (미사용)
# LANGFUSE_API_KEY=pk_...
# LANGFUSE_SECRET_KEY=sk_...
# LANGFUSE_PUBLIC_KEY=pk_...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================
# 로깅
# ============================================
# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
